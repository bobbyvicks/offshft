    "T2": {
      "name": "Clock Axis",
      "concept": "OFF and SHFT sit where 9 and 3 would be, so the name itself is the clock face and the hands pivot between the words. The mark is the same clock with the words reduced to two ticks.",
      "threads": [
        "Ink #1F2733 (letters)",
        "Rust #B4552D (hands)"
      ]
    },
    "T3": {
      "name": "Big O",
      "concept": "An O-with-hands monogram that also serves as the first letter of OFF, set larger than the caps like a drop initial. The monogram works alone on the side of a hat.",
      "threads": [
        "Ink #1F2733 (letters, ring)",
        "Rust #B4552D (hands)"
      ]
    },
    "T4": {
      "name": "Grid Lock",
      "concept": "The hands set the type. The minute hand is exactly one line pitch tall, the hub sits on the cap line of SHFT, and the hour hand ends on its baseline, so OFF and SHFT stack against the hands like a single unit.",
      "threads": [
